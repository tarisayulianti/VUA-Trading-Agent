# ============================================================
# VUA Trading Agent — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string for VUA persistence.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development with Docker Compose: postgresql://postgres:postgres@localhost:5432/vua_trading
# For production: Use your cloud provider's connection string + SSL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vua_trading"

# NODE_ENV: development | production
# In development: synthetic fallback is allowed (mocked market data).
# In production: synthetic fallback MUST be disabled.
NODE_ENV="development"
