# ============================================================
# VUA Trading Agent — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="http://localhost:3000"

# DATABASE_URL: Database connection string.
# Format for Profile B (PostgreSQL): postgresql://USER:***@HOST:PORT/DATABASE
# Format for Profile A (SQLite): file:./relative/path/to/database.db
# For local development with Docker Compose (Profile B): postgresql://postgres:***@localhost:5432/vua_trading
# For Profile A (local device/SQLite): file:./prisma-sqlite/data/vua_p0_002_a.db
# NOTE: This value selects the deployment database profile at server startup.
# It does NOT switch profiles at runtime. One process uses one profile for its entire lifetime.
DATABASE_URL="postgresql://postgres:***@localhost:5432/vua_trading"

# USE_SYNTHETIC_DATA: Explicit synthetic market-data mode.
# Default is false. Production behavior is fail-closed: exchange/API failures are not replaced
# with synthetic market data. Set to true ONLY for non-production/testing environments.
USE_SYNTHETIC_DATA="false"

# NODE_ENV: development | production
NODE_ENV="development"
